        "geckolib": "*"
    },
    "custom" : {
        "modmenu" : {
            "links" : {
                "modmenu.donate" : "https://paypal.me/superstrella",
                "modmenu.github_releases" : "https://github.com/superstrellaa/CinematicTools/releases",
                "modmenu.modrinth" : "https://modrinth.com/mod/CinematicTools",
                "modmenu.curseforge" : "https://www.curseforge.com/minecraft/mc-mods/CinematicTools"
            }
        }
    }
