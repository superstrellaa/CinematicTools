{
    "schemaVersion": 1,
    "id": "cinematictools",
    "version": "${version}",
    "name": "CinematicTools",
    "description": "A Fabric port of CMDCam with an integrated cinematic NPC system and dynamic skins. Perfect for machinimas and scripted scenes.",
    "authors": [
        "superstrellaa",
        "IceGames"
    ],
    "contact": {
        "email": "superstrellayt@gmail.com",
        "issues": "https://github.com/superstrellaa/CinematicTools/issues",
        "sources": "https://github.com/superstrellaa/CinematicTools",
        "homepage": "https://github.com/superstrellaa"
    },
    "license": "GPL-3.0-only",
    "icon": "cmdcam.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "es.superstrellaa.cinematictools.CinematicTools"
        ],
        "client": [
            "es.superstrellaa.cinematictools.client.CinematicToolsClient"
        ]
    },
    "mixins": [
        "compat.cinematictools.mixins.json",
        "cinematictools.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.0",
        "fabric": "*",
        "minecraft": "~1.21.1",
